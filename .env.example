# Chave da API da OpenAI. Nunca versione .env.local (no Netlify: variável de ambiente).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Controles de gasto (opcionais)
MAX_COST_PER_VERIFICATION_USD=0.10
MAX_WEB_SEARCHES=2
DAILY_COST_BUDGET_USD=5
DAILY_TOKEN_BUDGET=3000000
RATE_LIMIT_PER_MINUTE=4
RATE_LIMIT_PER_DAY=60
GLOBAL_DAILY_LIMIT=1500
