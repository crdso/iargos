# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Nunca versione o .env.local
GEMINI_API_KEY=
# Modelo Gemini Flash com Google Search Grounding + URL Context
GEMINI_MODEL=gemini-3.6-flash
# Limites (opcionais)
RATE_LIMIT_PER_MINUTE=4
RATE_LIMIT_PER_DAY=60
GLOBAL_DAILY_LIMIT=1500
